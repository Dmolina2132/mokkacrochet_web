# Configuración de Base de Datos
# Para desarrollo local con SQLite:
DATABASE_URL="file:./dev.db"

# Para producción con Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Para obtener la URL de Supabase:
# 1. Ve a https://supabase.com
# 2. Crea un proyecto nuevo
# 3. Ve a Settings → Database
# 4. Copia la Connection String → URI
# 5. Reemplaza [YOUR-PASSWORD] con tu contraseña de base de datos

# API Key para autenticación de administración (opcional, para dashboard)
ADMIN_API_KEY="tu-api-key-secreta-aqui"
